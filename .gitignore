# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# 에디터 플레이 중 생성되는 로컬 세이브 (SaveService — 에디터에서만 프로젝트 루트에 저장)
/[Ss]ave[Dd]ata/

# ──────────────────────────────────────────────
# 외부 에셋 (재배포 불가 — 저장소 미포함, README의 "외부 에셋 / 라이선스" 참고)
# 새 외부 에셋을 추가하면 여기에 먼저 등록할 것
# ──────────────────────────────────────────────
/[Aa]ssets/RPG Icons Pixel Art/
/[Aa]ssets/RPG Icons Pixel Art.meta
/[Aa]ssets/MasterStylizedProjectiles/
/[Aa]ssets/MasterStylizedProjectiles.meta
/[Aa]ssets/ithappy/
/[Aa]ssets/ithappy.meta
/[Aa]ssets/Toon Shaders Pro/
/[Aa]ssets/Toon Shaders Pro.meta
/[Aa]ssets/Casual_Hit/
/[Aa]ssets/Casual_Hit.meta
/[Aa]ssets/NoobGameDev/
/[Aa]ssets/NoobGameDev.meta
/[Aa]ssets/Vefects/
/[Aa]ssets/Vefects.meta

# 에디터 크래시 복구 씬
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta

# 개인 작업 자료
/CLAUDE.md
/Images/
