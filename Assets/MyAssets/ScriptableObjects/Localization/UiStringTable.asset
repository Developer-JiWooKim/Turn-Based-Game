  - Key: ui.pause.resume
    Ko: "\uACC4\uC18D\uD558\uAE30"
    En: Resume
  - Key: ui.pause.abort
    Ko: "\uBC30\uD2C0 \uC911\uB2E8"
    En: Abort Battle
  - Key: ui.pause.hint
    Ko: "ESC \uD0A4\uB85C\uB3C4 \uACC4\uC18D\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4"
    En: Press ESC to resume
