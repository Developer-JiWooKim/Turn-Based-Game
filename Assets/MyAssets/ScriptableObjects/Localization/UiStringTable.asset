    En: Crit DMG
  - Key: ui.stat.res
    Ko: "\uC800\uD56D"
    En: RES
  - Key: ui.stat.aggro
    Ko: "\uC5B4\uADF8\uB85C"
    En: Aggro
  - Key: choice.AttackUp.title
    Ko: "\uACF5\uACA9\uB825 \uAC15\uD654"
    En: Attack Up
  - Key: choice.AttackUp.desc
    Ko: "\uCCB4\uB825 +5%\n\uACF5\uACA9\uB825 +45%"
    En: 'HP +5%

      ATK +45%'
  - Key: choice.SpeedUp.title
    Ko: "\uC18D\uB3C4 \uAC15\uD654"
    En: Speed Up
  - Key: choice.SpeedUp.desc
    Ko: "\uCCB4\uB825 +10%\n\uC18D\uB3C4 +50%\n\uACF5\uACA9\uB825 +20%"
    En: 'HP +10%

      SPD +50%

      ATK +20%'
  - Key: choice.DefensiveUp.title
    Ko: "\uBC29\uC5B4 \uAC15\uD654"
    En: Defensive Up
  - Key: choice.DefensiveUp.desc
    Ko: "\uCCB4\uB825 +6%\n\uBC29\uC5B4\uB825 +60%\n\uACF5\uACA9\uB825 +14%\n\uC800\uD56D
      +10%p"
    En: 'HP +6%

      DEF +60%

      ATK +14%

      RES +10%p'
  - Key: choice.CritUp.title
    Ko: "\uCE58\uBA85\uD0C0 \uAC15\uD654"
    En: Crit Up
  - Key: choice.CritUp.desc
    Ko: "\uCCB4\uB825 +5%\n\uCE58\uBA85\uD0C0 +8%p\n\uCE58\uBA85\uD53C\uD574 +25%p"
    En: 'HP +5%

      Crit Rate +8%p

      Crit DMG +25%p'
  - Key: choice.Heal.title
    Ko: "\uD68C\uBCF5"
    En: Heal
  - Key: choice.Heal.desc
    Ko: "\uCD5C\uB300 \uCCB4\uB825\uC758\n50% \uD68C\uBCF5"
    En: 'Restore 50%

      of max HP'
  - Key: choice.EnemyStun.title
    Ko: "\uC2A4\uD134"
    En: Stun
  - Key: choice.EnemyStun.desc
    Ko: "\uB2E4\uC74C \uC2A4\uD14C\uC774\uC9C0\n\uC801 \uC804\uCCB4 \uCCAB \uD134
      \uD589\uB3D9 \uBD88\uAC00"
    En: 'Next stage

      Enemies skip first turn'
  - Key: choice.EnemyHpDown.title
    Ko: "\uC801 \uC57D\uD654"
    En: Enemy Weaken
  - Key: choice.EnemyHpDown.desc
    Ko: "\uB2E4\uC74C \uC2A4\uD14C\uC774\uC9C0\n\uC801 \uCCB4\uB825 -30%"
    En: 'Next stage

      Enemy HP -30%'
  - Key: choice.EnemyAtkDown.title
    Ko: "\uC801 \uACF5\uACA9\uB825 \uAC10\uC18C"
