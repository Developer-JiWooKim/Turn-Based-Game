    Ko: "\uACF5\uACA9\uB825"
    En: ATK
  - Key: ui.stat.spd
    Ko: "\uC18D\uB3C4"
    En: SPD
  - Key: ui.stat.def
    Ko: "\uBC29\uC5B4\uB825"
    En: DEF
  - Key: ui.stat.critRate
    Ko: "\uCE58\uBA85\uD0C0"
    En: Crit Rate
  - Key: ui.stat.critDmg
