  - Key: choice.EnemyAtkDown.desc
    Ko: "\uB2E4\uC74C \uC2A4\uD14C\uC774\uC9C0\n\uC801 \uACF5\uACA9\uB825 -30%"
    En: 'Next stage

      Enemy ATK -30%'
  - Key: choice.Recruit.title
    Ko: "\uC601\uC785"
    En: Recruit
  - Key: choice.Recruit.desc
    Ko: "\uC0C8\uB85C\uC6B4 \uB3D9\uB8CC\uAC00\n\uD30C\uD2F0\uC5D0 \uD569\uB958\uD569\uB2C8\uB2E4"
