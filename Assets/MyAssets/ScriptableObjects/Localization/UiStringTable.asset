  _entries:
  - Key: ui.title.start
    Ko: "\u25C6  \uC0C8\uB85C\uC6B4 \uC6D0\uC815  \u25C6"
    En: "\u25C6  NEW EXPEDITION  \u25C6"
  - Key: ui.title.continue
    Ko: "\uC774\uC5B4\uD558\uAE30"
    En: CONTINUE
  - Key: ui.title.option
    Ko: "\uC635\uC158"
    En: OPTION
  - Key: ui.title.quit
    Ko: "\uC885\uB8CC"
    En: QUIT
  - Key: ui.newrun.title
    Ko: "\uC0C8 \uC6D0\uC815 \uC2DC\uC791"
    En: New Expedition
  - Key: ui.newrun.body
    Ko: "\uC800\uC7A5\uB41C \uC774\uC5B4\uD558\uAE30 \uB370\uC774\uD130\uAC00 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4.
      \uC0C8\uB85C \uC2DC\uC791\uD560\uAE4C\uC694?"
    En: Your saved progress will be lost. Start a new expedition?
  - Key: ui.newrun.confirm
    Ko: "\uC0C8\uB85C \uC2DC\uC791"
    En: Start New
  - Key: ui.newrun.cancel
    Ko: "\uCDE8\uC18C"
    En: Cancel
  - Key: ui.select.header
    Ko: "\uCE90\uB9AD\uD130 \uC120\uD0DD"
    En: Select Character
  - Key: ui.select.back
    Ko: "\uB4A4\uB85C"
    En: Back
