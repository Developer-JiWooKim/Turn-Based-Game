    Ko: STAGE {0}
    En: STAGE {0}
  - Key: ui.hud.yourTurn
    Ko: "\uB2F9\uC2E0\uC758 \uCC28\uB840 \u2014 \uACF5\uACA9\uD560 \uBAAC\uC2A4\uD130\uB97C
      \uD074\uB9AD\uD558\uC138\uC694"
    En: "Your turn \u2014 click a monster to attack"
  - Key: ui.synergy.title
    Ko: "\uC2DC\uB108\uC9C0"
    En: Synergy
  - Key: ui.roguelike.header
    Ko: "\uC131\uC7A5 \uC120\uD0DD"
    En: Choose a Boon
  - Key: ui.recruit.header
    Ko: "\uB3D9\uB8CC \uC601\uC785"
    En: Recruit an Ally
  - Key: ui.recruit.replaceHeader
    Ko: "\uAD50\uCCB4\uD560 \uD30C\uD2F0\uC6D0 \uC120\uD0DD"
    En: Choose Who Leaves
  - Key: ui.recruit.skipTitle
    Ko: "\uC601\uC785 \uC548 \uD568"
    En: Don't Recruit
  - Key: ui.recruit.skipDesc
    Ko: "\uD604\uC7AC \uD30C\uD2F0\uB97C \uC720\uC9C0\uD569\uB2C8\uB2E4."
    En: Keep your current party.
