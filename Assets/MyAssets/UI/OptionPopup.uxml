<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    <Style src="Common.uss" />
    <!--
      옵션 팝업 (OptionPopupUI). Title/Battle 등 여러 씬의 UXML에서
      <ui:Template>/<ui:Instance>로 재사용한다. 표시/숨김은 OptionPopupUI가 담당.
    -->
    <ui:VisualElement name="option-popup" class="popup-overlay" style="display: none;">
        <ui:VisualElement class="popup-frame wood-panel">
            <ui:Label text="옵션" class="popup-title outline-text" />
            <ui:Slider name="master-volume-slider" label="마스터" low-value="0" high-value="1" value="1" class="option-slider" />
            <ui:Slider name="bgm-volume-slider" label="BGM" low-value="0" high-value="1" value="1" class="option-slider" />
            <ui:Slider name="sfx-volume-slider" label="효과음" low-value="0" high-value="1" value="1" class="option-slider" />

            <!-- 키 설정: 행은 OptionPopupUI가 InputManager의 논리 컨트롤 기반으로 동적 생성 -->
            <ui:Label text="키 설정" class="option-section-label outline-text" />
            <ui:VisualElement name="option-keybinds" class="keybind-list" />
            <ui:Button text="키 초기화" name="keybind-reset-button" class="btn btn-secondary" />

            <ui:Button text="닫기" name="option-close-button" class="btn btn-secondary" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
