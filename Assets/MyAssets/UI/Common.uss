/*
 * 공용 디자인 토큰 / 재사용 클래스
 * 색상·텍스트 규칙은 UI_DesignReference.md, 버튼 규칙은 UI_DesignReference2.md("Endless Expedition") 기준
 * 새 화면(UXML)에서는 이 파일을 @import 해서 재사용한다.
 */

:root {
    /* Title_background.jpg(밤하늘)·Title_Logo.png(시안·바이올렛 네온 로고)에서 뽑은 팔레트 */
    --color-abyss: #0A1220;
    --color-deep: #101B30;
    /* UI_DesignReference.md 아웃라인(공통) */
    --color-outline: #16202A;

    /* 패널 배경: 어두운 바이올렛 카드 (버튼과 같은 "Endless Expedition" 다크 톤) */
    --color-panel: #2A2440;

    --color-cyan-light: #A8F0FF;
    --color-cyan-mid: #63D8F5;

    --color-cream: #EAF6FF;

    /* UI_DesignReference2.md 버튼 팔레트 — Primary(민트) */
    --color-mint: #7AF0BE;
    --color-mint-bright: #A8FFD9;
    --color-mint-text: #EAFFF7;
    --color-surface-primary: #22373F;
    --color-surface-primary-hover: #2B4A54;
    --color-surface-primary-press: #192D37;

    /* Secondary(바이올렛) */
    --color-violet: #BFAEF0;
    --color-violet-dim: #6B5F92;
    --color-violet-text: #DED6F5;
    --color-surface-secondary: rgba(29, 22, 45, 0.88);
    --color-surface-secondary-hover: rgba(40, 30, 62, 0.94);

    /* Danger */
    --color-danger: #E08B8B;
    --color-danger-text: #FFDEDE;
    --color-surface-danger: #551B29;

    /* Disabled */
    --color-disabled-border: #3A3450;
    --color-disabled-text: #6A6383;
    --color-surface-disabled: rgba(20, 16, 29, 0.7);

    --color-heal: #6FBF3F;
    --color-recruit: #9A5FD4;
    --color-info: #3A7AC9;
}

/* 검은 아웃라인 + 굵은 텍스트 (타이틀/버튼/카드 공통) */
.outline-text {
    -unity-font-style: bold;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--color-outline);
}

/* 버튼 공통: 어두운 면 + 얇은 컬러 테두리 (UI_DesignReference2.md "Endless Expedition" 스타일) */
.btn {
    -unity-font-style: bold;
    color: var(--color-cream);
    font-size: 32px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--color-outline);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--color-outline);
    border-right-color: var(--color-outline);
    border-top-color: var(--color-outline);
    border-bottom-color: var(--color-outline);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    padding: 14px 40px;
    margin: 8px;
    translate: 0 0;
    transition-property: background-color, border-color, translate;
    transition-duration: 0.12s;
}

.btn:active {
    translate: 0 2px;
}

/* CTA 버튼: 어두운 청록 면 + 민트 테두리 */
.btn-cta {
    background-color: var(--color-surface-primary);
    color: var(--color-mint-text);
    border-left-color: var(--color-mint);
    border-right-color: var(--color-mint);
    border-top-color: var(--color-mint);
    border-bottom-color: var(--color-mint);
}

.btn-cta:hover {
    background-color: var(--color-surface-primary-hover);
    border-left-color: var(--color-mint-bright);
    border-right-color: var(--color-mint-bright);
    border-top-color: var(--color-mint-bright);
    border-bottom-color: var(--color-mint-bright);
}

.btn-cta:active {
    background-color: var(--color-surface-primary-press);
}

/* 보조 버튼: 반투명 다크 바이올렛 면 */
.btn-secondary {
    background-color: var(--color-surface-secondary);
    color: var(--color-violet-text);
    border-left-color: var(--color-violet-dim);
    border-right-color: var(--color-violet-dim);
    border-top-color: var(--color-violet-dim);
    border-bottom-color: var(--color-violet-dim);
    font-size: 24px;
}

.btn-secondary:hover {
    background-color: var(--color-surface-secondary-hover);
    border-left-color: var(--color-violet);
    border-right-color: var(--color-violet);
    border-top-color: var(--color-violet);
    border-bottom-color: var(--color-violet);
}

/* 위험/되돌릴 수 없는 동작 전용 (배틀 중단 등) */
.btn-danger {
    background-color: var(--color-surface-danger);
    color: var(--color-danger-text);
    border-left-color: var(--color-danger);
    border-right-color: var(--color-danger);
    border-top-color: var(--color-danger);
    border-bottom-color: var(--color-danger);
}

/* 비활성 버튼 (성향 배분 +/- 등 SetEnabled(false)로 눌러도 반응 없을 때) */
.btn:disabled {
    background-color: var(--color-surface-disabled);
    color: var(--color-disabled-text);
    border-left-color: var(--color-disabled-border);
    border-right-color: var(--color-disabled-border);
    border-top-color: var(--color-disabled-border);
    border-bottom-color: var(--color-disabled-border);
    opacity: 1;
}

/* 기본 패널 프레임 (정보 배너 / 팝업 프레임) */
.panel-frame {
    background-color: var(--color-panel);
    border-width: 5px;
    border-color: var(--color-outline);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

/* 팝업 오버레이 (OptionPopup 등 여러 화면에서 재사용) */
.popup-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(10, 18, 32, 0.6);
    align-items: center;
    justify-content: center;
}

.popup-frame {
    width: 480px;
    padding: 32px;
    align-items: center;
}

.popup-title {
    font-size: 36px;
    color: var(--color-cream);
    margin-bottom: 12px;
}

.popup-body {
    font-size: 20px;
    color: var(--color-cream);
    opacity: 0.8;
    margin-bottom: 24px;
}

/* 옵션 볼륨 슬라이더 */
.option-slider {
    width: 100%;
    margin-top: 6px;
    margin-bottom: 18px;
}

.option-slider .unity-base-field__label {
    color: var(--color-cream);
    font-size: 22px;
    min-width: 120px;
    -unity-font-style: bold;
}

/* 키 설정 섹션 */
.option-section-label {
    color: var(--color-cream);
    font-size: 22px;
    -unity-font-style: bold;
    margin-top: 6px;
    margin-bottom: 8px;
}

.keybind-list {
    margin-bottom: 12px;
}

.keybind-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}

.keybind-name {
    color: var(--color-cream);
    font-size: 20px;
    -unity-font-style: bold;
    min-width: 120px;
}

/* 현재 키 표시 겸 재설정 버튼 — 누르면 다음 입력을 대기한다 */
.keybind-key {
    min-width: 140px;
    font-size: 18px;
}

/* 재설정 대기 중 강조 */
.keybind-key--waiting {
    color: var(--color-cyan-light);
}
