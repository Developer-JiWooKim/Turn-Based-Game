<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    <Style src="Common.uss" />
    <Style src="PointAllocation.uss" />
    <!--
      성향 포인트 배분 팝업 (PointAllocationPopupUI). 카테고리 행은 C#이 allocation-rows에 채운다.
      OptionPopup과 동일하게 여러 화면의 UXML에서 <ui:Template>/<ui:Instance>로 재사용한다.
    -->
    <ui:VisualElement name="allocation-popup" class="popup-overlay" style="display: none;">
        <ui:VisualElement class="popup-frame panel-frame">
            <ui:Label text="ui.allocation.title" class="popup-title" />
            <ui:Label text="ui.allocation.points" name="allocation-points" class="allocation-header" />
            <ui:VisualElement name="allocation-rows" class="allocation-rows" />
            <ui:Button text="ui.allocation.reset" name="allocation-reset-button" class="btn btn-secondary" />
            <ui:Button text="ui.common.close" name="allocation-close-button" class="btn btn-secondary" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
