/* 화면 전체를 덮는 반투명 오버레이 (RoguelikeChoice와 동일한 톤) */
.result-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(16, 27, 48, 0.85);
}

.result-box {
    width: 420px;
    padding: 36px;
    align-items: center;
}

.result-title {
    font-size: 40px;
    color: var(--color-cream);
    margin-bottom: 28px;
}

.result-caption {
    font-size: 15px;
    color: var(--color-violet-text);
    opacity: 0.7;
    margin-bottom: 2px;
}

/* 이 런의 성과 — 결과 화면에서 가장 먼저 눈에 들어와야 하는 값 */
.result-stage {
    font-size: 72px;
    -unity-font-style: bold;
    color: var(--color-mint-bright);
    margin-bottom: 8px;
}

.result-best {
    font-size: 16px;
    color: var(--color-violet-text);
    opacity: 0.85;
    margin-bottom: 8px;
}

/* 크기만 오버라이드 — 배경/hover/pressed는 .btn(Common.uss)이 처리 */
.result-confirm {
    width: 200px;
    height: 52px;
    margin-top: 24px;
    font-size: 18px;
}
