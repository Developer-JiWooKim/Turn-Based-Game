/* 화면 전체를 덮는 반투명 오버레이 (BattleResult와 동일한 톤) */
.pause-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(16, 27, 48, 0.85);
}

.pause-box {
    width: 420px;
    padding: 36px;
    align-items: center;
}

.pause-title {
    font-size: 40px;
    color: var(--color-cream);
    margin-bottom: 28px;
}

.pause-caption {
    font-size: 15px;
    color: var(--color-violet-text);
    opacity: 0.7;
    margin-bottom: 2px;
}

.pause-stage {
    font-size: 72px;
    -unity-font-style: bold;
    color: var(--color-mint-bright);
    margin-bottom: 8px;
}

.pause-best {
    font-size: 16px;
    color: var(--color-violet-text);
    opacity: 0.85;
    margin-bottom: 8px;
}

/* 크기만 오버라이드 — 배경/hover/pressed는 .btn(Common.uss)이 처리 */
.pause-button {
    width: 200px;
    height: 52px;
    margin-top: 16px;
    font-size: 18px;
}

.pause-hint {
    margin-top: 20px;
    font-size: 13px;
    color: var(--color-violet-text);
    opacity: 0.6;
}
