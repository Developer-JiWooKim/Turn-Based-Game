/* 화면 전체를 덮는 반투명 오버레이 (BattleResult와 동일한 톤) */
.pause-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(16, 27, 48, 0.85);
}

.pause-box {
    width: 420px;
    padding: 36px;
    align-items: center;
}

.pause-title {
    font-size: 40px;
    color: var(--color-cream);
    margin-bottom: 28px;
}

.pause-caption {
    font-size: 15px;
    color: var(--color-violet-text);
    opacity: 0.7;
    margin-bottom: 2px;
}

.pause-stage {
    font-size: 72px;
    -unity-font-style: bold;
    color: var(--color-mint-bright);
    margin-bottom: 8px;
}

.pause-best {
    font-size: 16px;
    color: var(--color-violet-text);
    opacity: 0.85;
    margin-bottom: 8px;
}

/* 크기만 오버라이드 — 배경/hover/pressed는 .btn(Common.uss)이 처리 */
.pause-button {
    width: 200px;
    height: 52px;
    margin-top: 16px;
    font-size: 18px;
}

/* 연출이 재생 중이라 지금 눌러도 즉시 반영되지 않는 동안 잠기는 상태('배틀 중단').
   Common.uss의 .btn:disabled는 opacity를 1로 끄지만(성향 배분 +/- 버튼용) 여기서는
   눌리지 않는다는 게 한눈에 보여야 하므로 다시 낮춘다. 두 규칙의 특정도가 같아
   나중에 로드되는 이 파일이 이긴다(UXML의 <Style> 순서: Common.uss → BattlePause.uss). */
.pause-button:disabled {
    opacity: 0.4;
}

.pause-hint {
    margin-top: 20px;
    font-size: 13px;
    color: var(--color-violet-text);
    opacity: 0.6;
}
