/* 화면 전체를 덮는 반투명 오버레이 */
.roguelike-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(16, 27, 48, 0.75);
}

.roguelike-header {
    font-size: 34px;
    color: rgb(234, 246, 255);
    margin-bottom: 24px;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
}

.roguelike-cards {
    flex-direction: row;
    justify-content: center;
}

/* 배경/테두리는 .panel-frame(Common.uss)이 처리 */
.choice-card {
    width: 220px;
    height: 300px;
    margin: 12px;
    padding: 20px;
    align-items: center;
    justify-content: flex-start;
    transition-property: scale, border-color;
    transition-duration: 0.12s;
}

.choice-card:hover {
    scale: 1.05 1.05;
    border-color: var(--color-mint-bright);
}

/* 방향키로 겨냥한 카드(마우스 :hover와 동일한 강조) */
.choice-card--active {
    scale: 1.05 1.05;
    border-color: var(--color-mint-bright);
}

.card-icon {
    width: 56px;
    height: 56px;
    margin-bottom: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

/* 영입 후보 카드에서는 캐릭터 이름(교체 카드는 "A1 바바리안")이 들어온다.
   설명이 스탯 7줄로 늘어나 자리를 더 쓰므로 제목을 줄이고 아래 여백도 함께 좁혔다.
   .card-desc(15px)보다는 커야 제목-본문 위계가 뒤집히지 않는다. */
.card-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--color-cream);
    margin-bottom: 10px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.card-desc {
    font-size: 15px;
    color: var(--color-violet-text);
    opacity: 0.8;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* 영입/교체 카드의 스탯 표. 카드 폭을 다 쓰게 해야 라벨이 항상 같은 자리에서 시작한다
   (.choice-card가 align-items: center라 그냥 두면 내용 폭으로 줄어든다). */
.card-stats {
    width: 100%;
    margin-top: 2px;
}

.card-stat-row {
    flex-direction: row;
    align-items: center;
    margin: 1px 0;
}

/* 라벨 폭을 고정해 값들이 세로로 줄을 맞춘다(전투 하단 .party-stat-label과 같은 방식).
   영어 "Crit Rate"가 한국어 "치명피해"보다 길어 70px 아래로 줄이면 잘린다. */
.card-stat-label {
    width: 70px;
    flex-shrink: 0;
    font-size: 14px;
    color: var(--color-violet-text);
    opacity: 0.8;
    white-space: nowrap;
}

.card-stat-value {
    flex-grow: 1;
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--color-cream);
    white-space: nowrap;
}
