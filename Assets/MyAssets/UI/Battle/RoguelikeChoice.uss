/* 화면 전체를 덮는 반투명 오버레이 */
.roguelike-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(16, 27, 48, 0.75);
}

.roguelike-header {
    font-size: 34px;
    color: rgb(234, 246, 255);
    margin-bottom: 24px;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
}

.roguelike-cards {
    flex-direction: row;
    justify-content: center;
}

/* 배경/테두리는 .panel-frame(Common.uss)이 처리 */
.choice-card {
    width: 220px;
    height: 300px;
    margin: 12px;
    padding: 20px;
    align-items: center;
    justify-content: flex-start;
    transition-property: scale, border-color;
    transition-duration: 0.12s;
}

.choice-card:hover {
    scale: 1.05 1.05;
    border-color: var(--color-mint-bright);
}

/* 방향키로 겨냥한 카드(마우스 :hover와 동일한 강조) */
.choice-card--active {
    scale: 1.05 1.05;
    border-color: var(--color-mint-bright);
}

.card-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--color-cream);
    margin-bottom: 16px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.card-desc {
    font-size: 15px;
    color: var(--color-violet-text);
    opacity: 0.8;
    white-space: normal;
    -unity-text-align: middle-center;
}
