<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    <Style src="../Common.uss" />
    <Style src="BattlePause.uss" />
    <ui:VisualElement name="pause-panel" class="pause-overlay" style="display: none;">
        <ui:VisualElement class="pause-box panel-frame">
            <ui:Label name="pause-title" class="pause-title" text="ui.pause.title" />

            <ui:Label class="pause-caption" text="ui.pause.currentStage" />
            <ui:Label name="pause-stage" class="pause-stage" text="1" />

            <!-- 이전 최고 기록: 기록이 없는 첫 런에서는 숨긴다 -->
            <ui:Label name="pause-best" class="pause-best" text="" style="display: none;" />

            <ui:Button name="pause-resume" class="btn btn-secondary pause-button" text="ui.pause.resume" />
            <ui:Button name="pause-abort" class="btn btn-danger pause-button" text="ui.pause.abort" />
            <ui:Label name="pause-hint" class="pause-hint" text="ui.pause.hint" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
