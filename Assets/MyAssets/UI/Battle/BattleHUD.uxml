<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    <!-- Common.uss가 먼저 와야 :root 색 변수와 .panel-frame을 아래에서 쓸 수 있다 -->
    <Style src="../Common.uss" />
    <Style src="BattleHUD.uss" />
    <!-- picking-mode=Ignore: HUD가 몬스터 클릭 타겟팅을 가로채지 않도록 전부 통과 -->
    <ui:VisualElement name="battle-hud" class="battle-hud" picking-mode="Ignore">
        <ui:Label name="stage-label" class="stage-label" text="STAGE 1" picking-mode="Ignore" />
        <!--
            좌상단 세로 열. 두 패널을 하나의 절대 배치 컨테이너에 넣고 안에서는 일반 흐름으로 쌓는다 —
            시너지 패널은 행 수에 따라 높이가 변하고 없으면 통째로 숨겨지므로,
            아래 패널에 top을 고정하면 겹치거나 떠 보인다.
        -->
        <ui:VisualElement name="left-column" class="left-column" picking-mode="Ignore">
            <!-- 파티 시너지. 행은 SynergyPanelView가 실제 효과 수치에서 만든다(미발동은 흐리게) -->
            <ui:VisualElement name="synergy-panel" class="synergy-panel panel-frame" picking-mode="Ignore" />
            <!-- 지금까지 고른 성장 선택지 횟수. 행은 ChoicePickPanelView가 만든다(회복·디버프·영입 제외) -->
            <ui:VisualElement name="choice-pick-panel" class="pick-panel panel-frame" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="turn-order" class="turn-order" picking-mode="Ignore" />
        <ui:Label name="player-prompt" class="player-prompt" text="" picking-mode="Ignore" />
        <!-- 하단 파티 스탯 바. 패널은 PartyStatusBarView가 파티 인원만큼 만들어 캐릭터 위치에 정렬한다 -->
        <ui:VisualElement name="party-status" class="party-status" picking-mode="Ignore" />
        <!--
            우상단 버튼 줄. 루트가 picking-mode=Ignore여도 자식 버튼은 정상적으로 클릭된다.
            기본은 숨김 — 전투 구간에 들어갈 때 BattlePresenter.SetBattleActive가 켠다.
            아이콘은 Button의 background-image가 아니라 자식 요소로 넣는다 —
            background-image는 테두리까지 포함한 전체 박스를 채워서 padding으로 여백을 줄 수 없다.
        -->
        <ui:VisualElement name="hud-buttons" class="hud-buttons" style="display: none;">
            <ui:Button name="synergy-toggle" class="hud-button hud-toggle">
                <ui:VisualElement name="synergy-toggle-icon" class="hud-icon hud-icon--show" picking-mode="Ignore" />
                <ui:Label name="synergy-toggle-label" class="hud-toggle-label" picking-mode="Ignore" />
            </ui:Button>
            <!-- 버튼 순서는 화면의 패널 순서와 맞춘다(시너지 → 선택 기록 → 하단 스탯) -->
            <ui:Button name="pick-toggle" class="hud-button hud-toggle">
                <ui:VisualElement name="pick-toggle-icon" class="hud-icon hud-icon--show" picking-mode="Ignore" />
                <ui:Label name="pick-toggle-label" class="hud-toggle-label" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="party-toggle" class="hud-button hud-toggle">
                <ui:VisualElement name="party-toggle-icon" class="hud-icon hud-icon--show" picking-mode="Ignore" />
                <ui:Label name="party-toggle-label" class="hud-toggle-label" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="monster-info-button" class="hud-button">
                <ui:VisualElement class="hud-icon hud-icon--monster-info" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="pause-button" class="hud-button">
                <ui:VisualElement class="hud-icon hud-icon--pause" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
