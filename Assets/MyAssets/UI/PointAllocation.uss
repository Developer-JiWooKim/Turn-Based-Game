/* 성향 포인트 배분 팝업 전용 스타일. 공용 클래스(popup-*, btn, panel-frame)는 Common.uss 참조 */

.allocation-header {
    font-size: 22px;
    color: var(--color-cream);
    margin-bottom: 18px;
}

.allocation-rows {
    width: 100%;
    margin-bottom: 18px;
}

.allocation-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 4px;
}

.allocation-name {
    flex-grow: 1;
    color: var(--color-cream);
    font-size: 20px;
    -unity-font-style: bold;
}

.allocation-value {
    min-width: 44px;
    color: var(--color-cream);
    font-size: 20px;
    -unity-text-align: middle-center;
}

.allocation-step {
    width: 44px;
    min-width: 44px;
    height: 44px;
    padding-left: 0;
    padding-right: 0;
    margin-left: 6px;
    margin-right: 6px;
    font-size: 24px;
}
