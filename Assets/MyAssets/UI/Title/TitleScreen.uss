.screen-root {
    position: absolute;
    width: 100%;
    height: 100%;
}

/* ===== 공용 배경 ===== */
.background {
    position: absolute;
    width: 100%;
    height: 100%;    
}

/* 실제 통이미지를 적용하는 클래스 */
.bg-image {
    width: 100%;
    height: 100%;

    /* 프로젝트 내 이미지 파일 경로로 지정 (절대/상대 경로) */
    background-image: url('project://database/Assets/MyAssets/Textures/Title_background.jpg');

    /* 비율 유지하며 화면 전체 채우기 (남는 부분은 자름) */
    -unity-background-scale-mode: scale-and-crop;
}

/* 캐릭터 선택 전용 배경 */
.select-bg-image {
    width: 100%;
    height: 100%;

    background-image: url('project://database/Assets/MyAssets/Textures/CharacterSelect-background.jpg');
    -unity-background-scale-mode: scale-and-crop;
}

/* ===== 패널 공통 (State 별로 표시/숨김 전환) ===== */
.panel {
    position: absolute;
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

/* ===== TITLE 패널 ===== */
.title-wrap {
    position: absolute;
    top: 200px;
    align-items: center;
}

.title-logo {
    width: 1280px;
    height: 380px;

    align-self: center;
    margin-top: -150px;

    background-image: url('project://database/Assets/MyAssets/Textures/Title_Logo.png');
    -unity-background-scale-mode: scale-to-fit;
}

.title-logo-shadow {
    position: absolute;
    width: 1280px;
    height: 380px;

    margin-top: -140px;

    background-image: url('project://database/Assets/MyAssets/Textures/Title_Logo.png');
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(0,0,0,0.6);
}

/* ===== TITLE 메뉴 ===== */
.menu {
    position: absolute;
    bottom: 120px;
    width: 600px;              /* 폭을 명시해야 자식이 늘어날 기준이 생긴다 */
    flex-direction: column;
    align-items: stretch;      /* center면 버튼이 글자 폭으로 줄어든다 */
}

/* Common.uss의 .btn에 고정 width/margin이 있다면 여기서 무력화 */
.menu-btn {
    width: auto;
    margin: 0 0 12px 0;
    flex-shrink: 0;
}

.menu-btn--cta {
    height: 100px;
    font-size: 38px;
    letter-spacing: 2px;
}

.menu-btn--sub {
    height: 100px;
    font-size: 38px;
}

/* 마지막 줄: 가로 2분할 */
.menu-row {
    flex-direction: row;
    align-items: stretch;
}

.menu-btn--half {
    flex-grow: 1;
    flex-basis: 0;             /* 글자 길이와 무관하게 정확히 반반 */
    width: auto;
    height: 100px;
    font-size: 38px;
    margin: 0;
}

.menu-btn--half-right {
    margin-left: 12px;
}

/* ===== CHARACTER SELECT 패널 ===== */
.select-header {
    position: absolute;
    top: 40px;
    padding: 10px 48px;
}

.select-header-text {
    font-size: 40px;
    color: var(--color-cream);
}

.select-body {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.preview-column {
    align-items: center;
    margin: 0 32px;
}

/* 원형 스포트라이트 프리뷰 — 3D RenderTexture가 코드로 배선됨 */
.character-preview {
    width: 380px;
    height: 380px;
    background-color: rgba(10, 18, 32, 0.3);
    border-width: 5px;
    border-color: var(--color-outline);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
    -unity-background-scale-mode: scale-and-crop;
}

.character-name-row {
    flex-direction: row;
    align-items: center;
    margin-top: 16px;
}

.character-icon {
    width: 48px;
    height: 48px;
    margin-right: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.character-name {
    font-size: 44px;
    color: var(--color-cream);
    -unity-text-outline-width: 3px;
}

.stat-panel {
    margin-top: 16px;
    padding: 12px 20px;
    width: 380px;
}

.stat-row {
    flex-direction: row;
    align-items: center;
    margin: 3px 0;
}

.stat-label {
    width: 62px;
    font-size: 18px;
    color: var(--color-cream);
}

.stat-track {
    flex-grow: 1;
    height: 14px;
    background-color: var(--color-abyss);
    border-width: 2px;
    border-color: var(--color-outline);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    overflow: hidden;
}

.stat-fill {
    height: 100%;
    background-color: var(--color-cyan-light);
}

.stat-value {
    width: 56px;
    font-size: 18px;
    color: var(--color-cream);
    -unity-text-align: middle-right;
}

.nav-arrow {
    font-size: 48px;
    color: var(--color-cream);
    -unity-font-style: bold;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--color-outline);
    background-color: var(--color-deep);
    border-width: 4px;
    border-bottom-width: 8px;
    border-color: var(--color-outline);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
    width: 84px;
    height: 84px;
    padding: 0;
}

.nav-arrow:active {
    border-bottom-width: 4px;
    translate: 0 4px;
}

.indicator {
    position: absolute;
    bottom: 130px;
    flex-direction: row;
    justify-content: center;
}

.dot {
    width: 16px;
    height: 16px;
    margin: 0 8px;
    background-color: rgba(168, 240, 255, 0.35);
    border-width: 2px;
    border-color: var(--color-outline);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
}

.dot-active {
    background-color: var(--color-cyan-light);
    scale: 1.3 1.3;
}

.select-footer {
    position: absolute;
    bottom: 40px;
    flex-direction: row;
    justify-content: center;
}

/* ===== 공통 ===== */
.version-label {
    position: absolute;
    bottom: 16px;
    right: 20px;
    font-size: 16px;
    color: var(--color-cream);
    opacity: 0.8;
    -unity-text-outline-width: 1px;
}
