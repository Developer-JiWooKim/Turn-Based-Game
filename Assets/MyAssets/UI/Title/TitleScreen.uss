.screen-root {
    position: absolute;
    width: 100%;
    height: 100%;
}

/* ===== 공용 배경 ===== */
.background {
    position: absolute;
    width: 100%;
    height: 100%;
    flex-direction: column;
}

.bg-band {
    width: 100%;
}

.bg-sky {
    flex-grow: 5;
    background-color: var(--color-sky);
}

.bg-blend-1 {
    flex-grow: 1;
    background-color: #93D5C8;
}

.bg-grass-mid {
    flex-grow: 3;
    background-color: var(--color-grass-mid);
}

.bg-blend-2 {
    flex-grow: 1;
    background-color: #9BD888;
}

.bg-grass-dark {
    flex-grow: 4;
    background-color: var(--color-grass-dark);
}

.clouds {
    position: absolute;
    width: 100%;
    height: 100%;
}

.cloud {
    position: absolute;
    background-color: rgba(255, 255, 255, 0.85);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
}

.cloud-1 {
    width: 220px;
    height: 80px;
    top: 60px;
    left: 8%;
}

.cloud-2 {
    width: 160px;
    height: 60px;
    top: 120px;
    left: 55%;
}

.cloud-3 {
    width: 190px;
    height: 70px;
    top: 40px;
    left: 76%;
}

/* ===== 패널 공통 (State 별로 표시/숨김 전환) ===== */
.panel {
    position: absolute;
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

/* ===== TITLE 패널 ===== */
.title-wrap {
    align-items: center;
    margin-bottom: 60px;
}

.title-text {
    font-size: 110px;
    color: var(--color-cream);
    -unity-text-outline-width: 5px;
    letter-spacing: 4px;
    text-shadow: 0 6px 0 var(--color-outline);
}

.subtitle-text {
    font-size: 22px;
    color: var(--color-cream);
    opacity: 0.85;
    margin-top: 8px;
    -unity-text-outline-width: 2px;
}

.menu {
    flex-direction: column;
    align-items: center;
}

/* ===== CHARACTER SELECT 패널 ===== */
.select-header {
    position: absolute;
    top: 40px;
    padding: 10px 48px;
}

.select-header-text {
    font-size: 40px;
    color: var(--color-cream);
}

.select-body {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.preview-column {
    align-items: center;
    margin: 0 32px;
}

/* 원형 스포트라이트 프리뷰 — 3D RenderTexture가 코드로 배선됨 */
.character-preview {
    width: 380px;
    height: 380px;
    background-color: rgba(14, 22, 30, 0.25);
    border-width: 5px;
    border-color: var(--color-outline);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
    -unity-background-scale-mode: scale-and-crop;
}

.character-name {
    font-size: 44px;
    color: var(--color-cream);
    -unity-text-outline-width: 3px;
    margin-top: 16px;
}

.stat-panel {
    margin-top: 16px;
    padding: 12px 20px;
    width: 380px;
}

.stat-row {
    flex-direction: row;
    align-items: center;
    margin: 3px 0;
}

.stat-label {
    width: 62px;
    font-size: 18px;
    color: var(--color-cream);
}

.stat-track {
    flex-grow: 1;
    height: 14px;
    background-color: rgba(14, 22, 30, 0.45);
    border-width: 2px;
    border-color: var(--color-outline);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    overflow: hidden;
}

.stat-fill {
    height: 100%;
    background-color: var(--color-cream);
}

.stat-value {
    width: 56px;
    font-size: 18px;
    color: var(--color-cream);
    -unity-text-align: middle-right;
}

.nav-arrow {
    font-size: 48px;
    color: var(--color-cream);
    -unity-font-style: bold;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--color-outline);
    background-color: var(--color-wood-light);
    border-width: 4px;
    border-bottom-width: 8px;
    border-color: var(--color-outline);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
    width: 84px;
    height: 84px;
    padding: 0;
}

.nav-arrow:active {
    border-bottom-width: 4px;
    translate: 0 4px;
}

.indicator {
    position: absolute;
    bottom: 130px;
    flex-direction: row;
    justify-content: center;
}

.dot {
    width: 16px;
    height: 16px;
    margin: 0 8px;
    background-color: rgba(255, 248, 224, 0.45);
    border-width: 2px;
    border-color: var(--color-outline);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
}

.dot-active {
    background-color: var(--color-gold-light);
    scale: 1.3 1.3;
}

.select-footer {
    position: absolute;
    bottom: 40px;
    flex-direction: row;
    justify-content: center;
}

/* ===== 공통 ===== */
.version-label {
    position: absolute;
    bottom: 16px;
    right: 20px;
    font-size: 16px;
    color: var(--color-cream);
    opacity: 0.8;
    -unity-text-outline-width: 1px;
}
