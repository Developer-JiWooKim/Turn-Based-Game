.screen-root {
    position: absolute;
    width: 100%;
    height: 100%;
}

/* ===== 공용 배경 ===== */
.background {
    position: absolute;
    width: 100%;
    height: 100%;    
}

/* 실제 통이미지를 적용하는 클래스 */
.bg-image {
    width: 100%;
    height: 100%;

    /* 프로젝트 내 이미지 파일 경로로 지정 (절대/상대 경로) */
    background-image: url('project://database/Assets/MyAssets/Textures/Title_background.jpg');

    /* 비율 유지하며 화면 전체 채우기 (남는 부분은 자름) */
    -unity-background-scale-mode: scale-and-crop;
}

/* 캐릭터 선택 전용 배경 */
.select-bg-image {
    width: 100%;
    height: 100%;

    background-image: url('project://database/Assets/MyAssets/Textures/CharacterSelect-background.jpg');
    -unity-background-scale-mode: scale-and-crop;
}

/* ===== 패널 공통 (State 별로 표시/숨김 전환) ===== */
.panel {
    position: absolute;
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

/* ===== TITLE 패널 ===== */
.title-wrap {
    position: absolute;
    top: 200px;
    align-items: center;
}

.title-logo {
    width: 1280px;
    height: 380px;

    align-self: center;
    margin-top: -150px;

    background-image: url('project://database/Assets/MyAssets/Textures/Title_Logo.png');
    -unity-background-scale-mode: scale-to-fit;
}

.title-logo-shadow {
    position: absolute;
    width: 1280px;
    height: 380px;

    margin-top: -140px;

    background-image: url('project://database/Assets/MyAssets/Textures/Title_Logo.png');
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(0,0,0,0.6);
}

/*
  한국어 로고. TitlePanelUI가 언어에 따라 붙였다 뗀다.
  로고와 그림자가 같은 이미지를 쓰므로 둘 다 바꿔야 그림자만 영문으로 남지 않는다.
  이미지 경로만 덮어쓰고 크기·위치는 위 규칙을 그대로 물려받는다.
*/
.title-logo--ko {
    background-image: url('project://database/Assets/MyAssets/Textures/Title_Logo_Ko.png');
}

.title-logo-shadow--ko {
    background-image: url('project://database/Assets/MyAssets/Textures/Title_Logo_Ko.png');
}

/* ===== TITLE 메뉴 ===== */
.menu {
    position: absolute;
    bottom: 120px;
    width: 600px;              /* 폭을 명시해야 자식이 늘어날 기준이 생긴다 */
    flex-direction: column;
    align-items: stretch;      /* center면 버튼이 글자 폭으로 줄어든다 */
}

/* Common.uss의 .btn에 고정 width/margin이 있다면 여기서 무력화 */
.menu-btn {
    width: auto;
    margin: 0 0 12px 0;
    flex-shrink: 0;
}

/* 이어할 런이 없을 때의 '이어하기'. Common.uss의 .btn:disabled는 opacity를 1로 되돌리므로
   (성향 배분 +/- 버튼용) 여기서 다시 낮춘다 — 두 규칙의 특정도가 같아 나중에 로드되는
   이 파일이 이긴다(UXML의 <Style> 순서: Common.uss → TitleScreen.uss). */
.menu-btn:disabled {
    opacity: 0.9;
}

.menu-btn--cta {
    height: 100px;
    font-size: 38px;
    letter-spacing: 2px;
}

.menu-btn--sub {
    height: 100px;
    font-size: 38px;
}

/* 마지막 줄: 가로 2분할 */
.menu-row {
    flex-direction: row;
    align-items: stretch;
}

.menu-btn--half {
    flex-grow: 1;
    flex-basis: 0;             /* 글자 길이와 무관하게 정확히 반반 */
    width: auto;
    height: 100px;
    font-size: 38px;
    margin: 0;
}

.menu-btn--half-right {
    margin-left: 12px;
}

/* ===== CHARACTER SELECT 패널 ===== */
.select-header {
    position: absolute;
    top: 40px;
    padding: 10px 48px;
}

.select-header-text {
    font-size: 40px;
    color: var(--color-cream);
}

.select-body {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.preview-column {
    align-items: center;
    margin: 0 30px;
}

/* 원형 스포트라이트 프리뷰 — 3D RenderTexture가 코드로 배선됨 */
.character-preview {
    width: 360px;
    height: 360px;
    background-color: rgba(10, 18, 32, 0.3);
    border-width: 5px;
    border-color: var(--color-outline);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
    -unity-background-scale-mode: scale-and-crop;
}

.character-name-row {
    flex-direction: row;
    align-items: center;
    margin-top: 14px;
}

.character-icon {
    width: 46px;
    height: 46px;
    margin-right: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.character-name {
    font-size: 42px;
    color: var(--color-cream);
    -unity-text-outline-width: 3px;
}

.stat-panel {
    margin-top: 18px;
    padding: 12px 20px;
    width: 460px;
}

.stat-row {
    flex-direction: row;
    align-items: center;
    margin: 3px 0;
}

.stat-label {
    width: 100px;
    font-size: 18px;
    color: var(--color-cream);
}

.stat-track {
    flex-grow: 1;
    height: 14px;
    background-color: var(--color-abyss);
    border-width: 2px;
    border-color: var(--color-outline);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    overflow: hidden;
}

.stat-fill {
    height: 100%;
    background-color: var(--color-cyan-light);
}

.stat-value {
    width: 56px;
    font-size: 18px;
    color: var(--color-cream);
    -unity-text-align: middle-right;
}

.nav-arrow {
    align-items: center;
    justify-content: center;
    background-color: var(--color-deep);
    border-width: 4px;
    border-bottom-width: 8px;
    border-color: var(--color-outline);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
    width: 84px;
    height: 84px;
    padding: 0;
}

.nav-arrow:active {
    border-bottom-width: 4px;
    translate: 0 4px;
}

/*
  화살표 아이콘. 그림 경로는 USS가 들고 UXML은 클래스만 붙인다(HUD 버튼과 같은 방식).
  ⚠️ 파일 확장자가 대문자 '.Png'다 — url()은 실제 파일명과 정확히 같아야 한다.
*/
.nav-arrow-icon {
    width: 40px;
    height: 40px;
    -unity-background-scale-mode: scale-to-fit;
}

.nav-arrow-icon--prev {
    background-image: url('project://database/Assets/MyAssets/Textures/Icons/UI/LeftArrow.Png');
}

.nav-arrow-icon--next {
    background-image: url('project://database/Assets/MyAssets/Textures/Icons/UI/RightArrow.Png');
}

.indicator {
    position: absolute;
    bottom: 130px;
    flex-direction: row;
    justify-content: center;
}

.dot {
    width: 16px;
    height: 16px;
    margin: 0 8px;
    background-color: rgba(168, 240, 255, 0.35);
    border-width: 2px;
    border-color: var(--color-outline);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
}

.dot-active {
    background-color: var(--color-cyan-light);
    scale: 1.3 1.3;
}

.select-footer {
    position: absolute;
    bottom: 40px;
    flex-direction: row;
    justify-content: center;
}

/* ===== 공통 ===== */
.version-label {
    position: absolute;
    bottom: 16px;
    right: 20px;
    font-size: 16px;
    color: var(--color-cream);
    opacity: 0.8;
    -unity-text-outline-width: 1px;
}
