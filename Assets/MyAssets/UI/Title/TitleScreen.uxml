<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    <Style src="../Common.uss" />
    <Style src="TitleScreen.uss" />
    <ui:Template name="OptionPopup" src="../OptionPopup.uxml" />
    <ui:Template name="PointAllocationPopup" src="../PointAllocation.uxml" />
    <ui:Template name="NewRunWarningPopup" src="../NewRunWarning.uxml" />
    <ui:VisualElement name="screen-root" class="screen-root" picking-mode="Ignore">
        <!-- TitlePanelUI._rootElementName = "title-panel" -->
        <ui:VisualElement name="title-panel" class="panel" picking-mode="Ignore">
            <!-- 타이틀 전용 배경. character-select-panel과 display:none으로 서로 배타적이라 패널 전환 시 자동으로 같이 바뀐다 -->
            <ui:VisualElement name="background" class="background" picking-mode="Ignore">
                <ui:VisualElement class="bg-image" picking-mode="Ignore"/>
            </ui:VisualElement>

            <ui:VisualElement name="title-wrap" class="title-wrap" picking-mode="Ignore">
                <ui:VisualElement name="game-title-shadow" class="title-logo-shadow" picking-mode="Ignore" />
                <ui:VisualElement name="game-title" class="title-logo" picking-mode="Ignore" />                    
            </ui:VisualElement>
            <ui:VisualElement name="menu" class="menu" picking-mode="Ignore">
                    <ui:Button text="ui.title.start" name="start-button" class="btn btn-cta menu-btn menu-btn--cta" />
                    <ui:Button text="ui.title.continue" name="continue-button" class="btn btn-secondary menu-btn menu-btn--sub" />

                <ui:VisualElement name="menu-row" class="menu-row" picking-mode="Ignore">
                    <ui:Button text="ui.title.option" name="option-button" class="btn btn-secondary menu-btn--half" />
                    <ui:Button text="ui.title.quit" name="quit-button" class="btn btn-secondary menu-btn--half menu-btn--half-right" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- CharacterSelectPanelUI._rootElementName = "character-select-panel" -->
        <ui:VisualElement name="character-select-panel" class="panel" style="display: none;">
            <!-- 캐릭터 선택 전용 배경 -->
            <ui:VisualElement name="select-background" class="background" picking-mode="Ignore">
                <ui:VisualElement class="select-bg-image" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement name="select-header" class="select-header panel-frame">
                <ui:Label text="ui.select.header" class="select-header-text" />
            </ui:VisualElement>
            <ui:VisualElement name="select-body" class="select-body" picking-mode="Ignore">
                <!-- 화살표는 글자(◀)가 아니라 아이콘이다. Button의 background-image를 쓰지 않는 이유는
                     그쪽이 원형 테두리까지 포함한 전체 박스를 채워 여백을 줄 수 없기 때문 -->
                <ui:Button name="prev-button" class="nav-arrow">
                    <ui:VisualElement class="nav-arrow-icon nav-arrow-icon--prev" picking-mode="Ignore" />
                </ui:Button>
                <ui:VisualElement name="preview-column" class="preview-column" picking-mode="Ignore">
                    <!-- 프리뷰 카메라의 RenderTexture가 CharacterSelectPanelUI에서 배선됨 -->
                    <ui:VisualElement name="character-preview" class="character-preview" />
                    <ui:VisualElement name="character-name-row" class="character-name-row">
                        <ui:VisualElement name="character-icon" class="character-icon" />
                        <ui:Label text="Knight" name="character-name" class="character-name outline-text" />
                    </ui:VisualElement>
                    <!-- 각 행의 fill 너비와 value 텍스트는 CharacterSelectPanelUI가 채운다 -->
                    <ui:VisualElement name="stat-panel" class="stat-panel panel-frame">
                        <ui:VisualElement name="stat-row" class="stat-row">
                            <ui:Label text="ui.stat.hp" class="stat-label" />
                            <ui:VisualElement class="stat-track">
                                <ui:VisualElement name="stat-fill" class="stat-fill" />
                            </ui:VisualElement>
                            <ui:Label name="stat-value" class="stat-value" />
                        </ui:VisualElement>
                        <ui:VisualElement name="stat-row" class="stat-row">
                            <ui:Label text="ui.stat.atk" class="stat-label" />
                            <ui:VisualElement class="stat-track">
                                <ui:VisualElement name="stat-fill" class="stat-fill" />
                            </ui:VisualElement>
                            <ui:Label name="stat-value" class="stat-value" />
                        </ui:VisualElement>
                        <ui:VisualElement name="stat-row" class="stat-row">
                            <ui:Label text="ui.stat.spd" class="stat-label" />
                            <ui:VisualElement class="stat-track">
                                <ui:VisualElement name="stat-fill" class="stat-fill" />
                            </ui:VisualElement>
                            <ui:Label name="stat-value" class="stat-value" />
                        </ui:VisualElement>
                        <ui:VisualElement name="stat-row" class="stat-row">
                            <ui:Label text="ui.stat.def" class="stat-label" />
                            <ui:VisualElement class="stat-track">
                                <ui:VisualElement name="stat-fill" class="stat-fill" />
                            </ui:VisualElement>
                            <ui:Label name="stat-value" class="stat-value" />
                        </ui:VisualElement>
                        <ui:VisualElement name="stat-row" class="stat-row">
                            <ui:Label text="ui.stat.critRate" class="stat-label" />
                            <ui:VisualElement class="stat-track">
                                <ui:VisualElement name="stat-fill" class="stat-fill" />
                            </ui:VisualElement>
                            <ui:Label name="stat-value" class="stat-value" />
                        </ui:VisualElement>
                        <ui:VisualElement name="stat-row" class="stat-row">
                            <ui:Label text="ui.stat.res" class="stat-label" />
                            <ui:VisualElement class="stat-track">
                                <ui:VisualElement name="stat-fill" class="stat-fill" />
                            </ui:VisualElement>
                            <ui:Label name="stat-value" class="stat-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="next-button" class="nav-arrow">
                    <ui:VisualElement class="nav-arrow-icon nav-arrow-icon--next" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="indicator" class="indicator" picking-mode="Ignore">
                <ui:VisualElement class="dot dot-active" />
                <ui:VisualElement class="dot" />
                <ui:VisualElement class="dot" />
                <ui:VisualElement class="dot" />
                <ui:VisualElement class="dot" />
                <ui:VisualElement class="dot" />
            </ui:VisualElement>
            <ui:VisualElement name="select-footer" class="select-footer" picking-mode="Ignore">
                <ui:Button text="ui.select.back" name="select-back-button" class="btn btn-secondary" />
                <ui:Button text="ui.select.allocation" name="allocation-button" class="btn btn-secondary" />
                <ui:Button text="ui.select.battle" name="battle-button" class="btn btn-cta" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label text="v0.0.1" name="version-label" class="version-label outline-text" />

        <!-- Instance의 TemplateContainer 래퍼: 내용물 크기 기본값이라 화면 전체로 늘리되, 팝업이 닫혔을 때 클릭을 가로채지 않도록 Ignore -->
        <ui:Instance template="OptionPopup" picking-mode="Ignore" style="position: absolute; width: 100%; height: 100%;" />
        <ui:Instance template="PointAllocationPopup" picking-mode="Ignore" style="position: absolute; width: 100%; height: 100%;" />
        <ui:Instance template="NewRunWarningPopup" picking-mode="Ignore" style="position: absolute; width: 100%; height: 100%;" />
    </ui:VisualElement>
</ui:UXML>
